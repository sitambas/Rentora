# Copy to .env and adjust.
DATABASE_URL="postgresql://YOUR_DB_USER@localhost:5432/rentora_app?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated origins allowed to call the API (web app). Mobile apps don't send an Origin.
CORS_ORIGINS="http://localhost:3000"

# Folder for uploaded lease documents (agreements, Aadhaar cards). Defaults to apps/api/uploads.
# On a server, point this at persistent storage and back it up.
# UPLOADS_DIR="/var/lib/rentora/uploads"
