{
  "name": "@rentora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "NODE_ENV=production tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma migrate dev --name init && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "NODE_ENV=test tsx --env-file=.env.test --test src/api.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@rentora/shared": "0.1.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/morgan": "1.9.9",
    "@types/node": "22.15.3",
    "prisma": "6.19.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  }
}
